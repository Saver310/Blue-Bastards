#library "KickyDicky"
#include "zcommon.acs"

Script "Kick" ENTER
{
	while (True){
		Delay(1);
		if (GetCvar("bb_kicking")){
			if(GetPlayerInput(-1,INPUT_OLDBUTTONS)&BT_ZOOM)
			{
				if (CheckInventory("DeathsheadFist"))
					UseInventory("DeathsheadKicky");
				if (CheckInventory("SpotMallet"))
					UseInventory("SpotKicky");
			}
		}
    }
} 