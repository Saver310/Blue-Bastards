class Dragon_Spot_Transform : CustomInventory {
   
    Default
	{
		Tag " ";
		+INVENTORY.UNDROPPABLE
		Inventory.RestrictedTo "Spot";
	}

    action void TryTransform()
    {
        A_Print("$SPOT_TRANSFORM_INIT", 5);
        let ppawn = PlayerPawn(self);

        if (!ppawn){
            return;
        }

        if (ppawn.Alternative == null){
            A_PlaySound("misc/protect", CHAN_AUTO);
            A_Morph("SpotDragon", 35 * 30, MRF_FULLHEALTH, "BlueBastardsTransformationFog", "BlueBastardsTransformationFog");
        }
    }

    States {
        Use:
            TNT1 A 0 TryTransform();
            stop;
    }
}

// this is atrocious lol
