class DeathsheadRocketLauncher : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	Default
	{
		Weapon.SelectionOrder 700;
		Weapon.AmmoType1 "Rocketammo";
		Weapon.AmmoUse1 1;
		Weapon.AmmoGive1 2;
		Weapon.AmmoType2 "Rocketammo";
		Weapon.AmmoUse2 1;
		Weapon.AmmoGive2 0;
		Weapon.BobRangeX 1.5;
		Weapon.BobRangeY 0.5;
		
		Tag "$ACE_ROCKET";
		Obituary "$OB_ACE_ROCKET";
		+INVENTORY.UNDROPPABLE
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADRK JIHGF 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADRK F 2 A_StartSound("weapons/rocket/load");
		ADRK GHIJA 2;
	RealReady:
		ADRK A 1 A_WeaponReady;
		Loop;
	Fire:
		ADRK B 0
		{
			A_StartSound("weapons/rocket", CHAN_AUTO);
			A_FireProjectile("DeathsheadRocket");
			A_Recoil(2);
			A_SetPitch(self.pitch - 6, SPF_INTERPOLATE);
		}
		ADRK BC 2 Bright
		{
			A_WeaponOffset(8.0, 8.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		}
		ADRK DE 2 Bright
		{
			A_WeaponOffset(2.0, 2.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		}
		ADRK A 0 A_StartSound("weapons/rocket/load", CHAN_AUTO, CHANF_DEFAULT, 0.5);
		ADRK AA 2 Bright 
		{
			A_WeaponOffset(-2.0, -2.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		}
		ADRK AA 2 Bright A_WeaponOffset(-8.0, -8.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK A 2 A_ReFire;
		Goto RealReady;
	AltFire:
		ADRK B 0
		{
			A_StartSound("weapons/rocketshotty", CHAN_AUTO);
			A_FireProjectile("DeathsheadRocket",0);
			A_FireProjectile("DeathsheadRocket",-5);
			A_FireProjectile("DeathsheadRocket",5);
			A_Recoil(2);
			A_SetPitch(self.pitch - 6, SPF_INTERPOLATE);
		}
		ADRK BC 2 Bright
		{
			A_WeaponOffset(8.0, 8.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		}
		ADRK DE 2 Bright
		{
			A_WeaponOffset(2.0, 2.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		}
		ADRK A 0 A_StartSound("weapons/rocket/load", CHAN_AUTO, CHANF_DEFAULT, 0.5);
		ADRK AA 2 Bright 
		{
			A_WeaponOffset(-2.0, -2.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		}
		ADRK AA 2 Bright A_WeaponOffset(-8.0, -8.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK A 1
		{
			A_StartSound("weapons/rocketshotty/cock", CHAN_AUTO);
			A_WeaponOffset(2.0, 4.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
		}
		ADRK A 1 A_WeaponOffset(6.0, 12.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK A 1 A_WeaponOffset(2.0, 4.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK AAAA 1 
		{
			A_WeaponOffset(-2.0, -4.0, WOF_ADD|WOF_INTERPOLATE);
			A_SetPitch(self.pitch - 0.5, SPF_INTERPOLATE);
		}
		ADRK A 4 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
		ADRK A 2 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadRocket : Rocket
{
	Default
	{
		Speed 35;
		Damage 30;
		SeeSound "weapons/rocket";
	}
	States
	{
	Spawn:
		MISL A 1 Bright;
		Loop;
	Death:
		MISL B 8 Bright A_Explode;
		MISL C 6 Bright;
		MISL D 4 Bright;
		Stop;
	BrainExplode:
		MISL BC 10 Bright;
		MISL D 10 A_BrainExplode;
		Stop;
	}
}
