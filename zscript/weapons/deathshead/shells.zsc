class DeathsheadShotgun : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	Default
	{
		Weapon.SelectionOrder 400;
		Weapon.AmmoType "Shell";
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 8;
		Weapon.BobRangeY 0.5;
		Weapon.BobRangeX 1;
		Tag "$ACE_AUTOSHOTGUN";
		Obituary "$OB_ACE_AUTOSHOTGUN";
		+INVENTORY.UNDROPPABLE
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADSG GHIJKLM 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADSG M 2 A_StartSound("weapons/autoshotgun/deploy");
		ADSG LKJIHGA 2;
	RealReady:
		ADSG A 1 A_WeaponReady;
		Loop;
	Fire:
		ADSG B 1 Bright
		{
			A_FireBullets (6, 6, 12, random(2,5), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/autoshotgun", CHAN_AUTO);
			A_GunFlash();
			A_SetPitch(self.pitch - 2, SPF_INTERPOLATE);
		}
		ADSG CCDD 1 Bright A_SetPitch(self.pitch + 0.5, SPF_INTERPOLATE);
		ADSG EFA 2 A_ReFire;
		Goto RealReady;
	Flash:
		ADSG N 1 Bright A_Light2;
		ADSG O 2 Bright A_Light1;
		Goto LightDone;
	}
}

class DeathsheadSuperShotgun : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	bool side;
	Default
	{
		Weapon.SelectionOrder 500;
		Weapon.AmmoType1 "Shell";
		Weapon.AmmoUse1 2;
		Weapon.AmmoGive1 16;
		Weapon.AmmoType2 "Shell";
		Weapon.AmmoUse2 2;
		Weapon.AmmoGive2 0;
		
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1;
		
		Tag "$ACE_SAWNOFFS";
		Obituary "$OB_ACE_SAWNOFFS";
		+WEAPON.NOAUTOFIRE
		+INVENTORY.UNDROPPABLE;
	}
	
    States
	{
	Select:
		TNT1 A 0 Offset(0,32) A_Overlay(2,"LeftSelect");
		ADDB I 2 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB HGFE 2;
		Goto Ready;
	LeftSelect:
		TNT1 A 0 A_BBLefthand(OverlayId());
		ADDB I 2 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB HGFE 2;
		Goto LeftReady;
	Deselect:
		ADDB A 0 {
			A_Overlay(2,"LeftDeselect");
			A_BBLefthand(2);
		}
		ADDB EFGHI 2;
		ADDB I 1 A_Lower(24);
		Wait;
	LeftDeselect:
		ADDB EFGHI 2;
		ADDB I 1;
		Wait;
	Ready:
		ADDB A 1 A_WeaponReady();
 		Loop;
	LeftReady:
		ADDB A 1;
		Wait;
	AltFire:
		ADPS A 0 { A_Overlay(2,"LeftFire"); return ResolveState("RightFire"); }
	Fire:
		ADPS A 0 {
			if (Invoker.side) { Invoker.side = false; A_Overlay(2,"LeftFire"); return ResolveState("Ready"); }
			else { Invoker.side = true; return ResolveState("RightFire"); }
		}
	RightFire:
		ADDB M 1 Bright {
			A_FireBullets(11.8, 6.8, 20, random(6,8), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/doubleshotties", CHAN_AUTO);
			A_GunFlash();
			A_Quake(3,2,0,16);
			A_Recoil(5*cos(pitch));
			a_overlay(4,"KnockbackFX");
		}
		ADDB M 1 Bright A_SetPitch(self.pitch - 12, SPF_INTERPOLATE);
		ADDB N 2 Bright{
			A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
			A_overlayOffset(2,Random(-2,2),Random(-2,2) + 36);
			A_overlayOffset(1,Random(-2,2),Random(-2,2) + 36);
		}
		ADDB CCCCC 2{
			A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
			A_overlayOffset(2,Random(-2,2),Random(-2,2) + 36);
			A_overlayOffset(1,Random(-2,2),Random(-2,2) + 36);
		}
		ADDB D 2;
		ADDB A 0 A_CheckReload;
		ADDB EFG 2;
		ADDB H 2 A_StartSound("weapons/sshoto", CHAN_AUTO);
		ADDB I 2 A_StartSound("weapons/sshotl", CHAN_AUTO);
		ADDB J 2 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB KLC 2;
		Goto Ready;
	LeftFire:
		TNT1 A 0 A_BBLefthand(OverlayId());
		ADDB M 1 Bright {
			A_FireBullets(11.8, 6.8, 20, random(6,8), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/doubleshotties", CHAN_AUTO);
			A_Overlay(999,"LeftFlash");
			A_Quake(3,2,0,16);
			A_Recoil(5*cos(pitch));
			a_overlay(4,"KnockbackFX");
		}
		ADDB M 1 Bright A_SetPitch(self.pitch - 12, SPF_INTERPOLATE);
		ADDB N 2 Bright{
			A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
			A_overlayOffset(2,Random(-2,2),Random(-2,2) + 36);
			A_overlayOffset(1,Random(-2,2),Random(-2,2) + 36);
		}
		ADDB CCCCC 2{
			A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
			A_overlayOffset(2,Random(-2,2),Random(-2,2) + 36);
			A_overlayOffset(1,Random(-2,2),Random(-2,2) + 36);
		}
		ADDB D 2;
		ADDB A 0 A_CheckReload;
		ADDB EFG 2;
		ADDB H 2 A_StartSound("weapons/sshoto", CHAN_AUTO);
		ADDB I 2 A_StartSound("weapons/sshotl", CHAN_AUTO);
		ADDB J 2 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB KLC 2;
		Goto LeftReady;
	Flash:
		TNT1 A 2 A_Light1;
		TNT1 A 2 A_Light2;
		Goto LightDone;
		
	KnockbackFX:
		TNT1 A 2
		{
			A_overlayscale(PSP_WEAPON,1.6); //PSP_WEAPON is the equivalent of layer 1 in the overlays.
			A_overlayscale(2,1.6); //PSP_FLASH is the overlay that gunflash uses
		}
		TNT1 A 2
		{
			A_overlayscale(1,1.5);
			A_overlayscale(2,1.5);
		}
		TNT1 A 2;
		TNT1 A 1
		{
			A_overlayscale(1,1.45);
			A_overlayscale(2,1.45);
		}
		TNT1 A 1
		{
			A_overlayscale(1,1.40);
			A_overlayscale(2,1.40);
		}
		TNT1 A 2
		{
			A_overlayscale(1,1.35);
			A_overlayscale(2,1.35);
		}
		TNT1 A 2
		{
			A_overlayscale(1,1.15);
			A_overlayscale(2,1.15);
		}
		TNT1 A 2
		{
			A_overlayscale(1,1.05);
			A_overlayscale(2,1.05);
		}
		TNT1 A 1
		{
			A_overlayscale(1,1);
			A_overlayscale(2,1);
		}
		stop;
	}
}
