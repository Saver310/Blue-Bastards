class DeathsheadPistol : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	bool side;
	const leftSidelayer = 2;
	const rightSidelayer = 3;
	Default
	{
		Weapon.SelectionOrder 800;
		Weapon.AmmoType1 "BBDeathshead9mm";
		Weapon.AmmoGive1 20;
		Weapon.AmmoUse1 1;
		Weapon.AmmoType2 "BBDeathshead9mm";
		Weapon.AmmoGive2 0;
		Weapon.AmmoUse2 1;
		Weapon.BobSpeed 1.5;
		+WEAPON.NOALERT
		+WEAPON.NOAUTOFIRE
		+INVENTORY.UNDROPPABLE
		Tag "$ACE_PISTOL";
		Obituary "$OB_ACE_PISTOL";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 16 {
			player.mo.speed = 1.0; 
			int roll_the_dice = random(0,1);
			switch (roll_the_dice) 
			{
			case 0:
			  A_Overlay(leftSidelayer,"LeftDeselect");  A_Overlay(rightSidelayer,"RightDeselect");
			  break;
			case 1:
			  A_Overlay(leftSidelayer,"RightDeselect");  A_Overlay(rightSidelayer,"LeftDeselect");
			  break;
			}
		}
		TNT1 A 0 A_Lower(24);
		Wait;
	RightDeselect:
		TNT1 A 0 { if (OverlayId() == leftSidelayer) A_BBLefthand(leftSidelayer);}
		ADPS S 2 A_StartSound("weapons/deagle/deploy");
		ADPS RQPONM 2;
		Wait;
	LeftDeselect:
		TNT1 A 0 { if (OverlayId() == leftSidelayer) A_BBLefthand(leftSidelayer);}
		ADPS FGHIJKL 2;
		Wait;
	Ready:
		TNT1 A 0 { 
			player.mo.speed = 1.08; 
			A_Overlay(leftSidelayer,"LeftSelect");
			A_Jump(256,"Ready1","Ready2");
		}
	Ready1:
		ADPS L 2 A_StartSound("weapons/adpistol/deploy");
		ADPS KJIHGFE 2;
		Goto RealReady;
	Ready2:
		ADPS M 2 
		{
			A_StartSound("weapons/adpistol/deploy", CHAN_AUTO);
			A_StartSound("weapons/deagle/deploy", CHAN_AUTO);
		}
		ADPS NOPQRST 2;
		Goto RealReady;
	RealReady:
		TNT1 A 0 A_Overlay(leftSidelayer,"GunReady");
		TNT1 A 0 A_Overlay(rightSidelayer,"GunReady");
		TNT1 A 1 A_WeaponReady(WRF_ALLOWRELOAD);
		Wait;
	GunReady:
		TNT1 A 0 { if (OverlayId() == leftSidelayer) A_BBLefthand(leftSidelayer);}
		ADPS A 1;
		Wait;
	Fire:
		ADPS A 0 {
			if (bb_pistols_akimbo_alt) A_Overlay(leftSidelayer,"GunFire");
			else {
				if (Invoker.side) { Invoker.side = false; A_Overlay(leftSidelayer,"GunFire");}
				else { Invoker.side = true; A_Overlay(rightSidelayer,"GunFire"); }
			}
		}
		TNT1 A 1;
		TNT1 AAAAA 1 {
			A_WeaponReady(WRF_NOPRIMARY);
			if (player.cmd.buttons & BT_ATTACK && !(player.oldbuttons & BT_ATTACK))
			{
				return ResolveState("Fire");
			}
			return ResolveState(null);
		}
		TNT1 A 1 A_ReFire();
		Goto RealReady+2;
	AltFire:
		ADPS A 0 {
			if (bb_pistols_akimbo_alt) { A_Overlay(rightSidelayer,"GunFire"); return ResolveState(null); };
			return ResolveState("RealReady");
		}
		TNT1 A 1;
		TNT1 AAAAA 1 {
			A_WeaponReady(WRF_NOSECONDARY);
			if (player.cmd.buttons & BT_ALTATTACK && !(player.oldbuttons & BT_ALTATTACK))
			{
				return ResolveState("AltFire");
			}
			return ResolveState(null);
		}
		TNT1 A 1 A_ReFire();
		Goto RealReady+2;
	GunFire:
		ADPS B 1 Bright
		{
			A_AlertMonsters();
			A_FireBullets (4, 2, -1, random(8,20), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/adpistol", CHAN_AUTO);
			if (OverlayId() == leftSidelayer) {
				A_BBLefthand(leftSidelayer);
				A_Overlay(999,"Flash");
			}
			else {
				A_GunFlash();
			}
		}
		ADPS BCCDD 1 Bright;
		ADPS EEAA 1;
		Goto RealReady;
	Flash:
		TNT1 A 0 { if (OverlayId() == 999) A_BBLefthand(999);}
		ADPS U 2 Bright A_Light2;
		ADPS V 2 Bright A_Light1;
		Goto LightDone;
	Reload:
		TNT1 A 0 { A_Overlay(leftSidelayer,"LeftReload"); A_Overlay(rightSidelayer,"RightReload"); }
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 {
			if (player.cmd.buttons & BT_ATTACK && !(player.oldbuttons & BT_ATTACK))
			{
				return ResolveState("Fire");
			}
			return ResolveState(null);
		}
		Goto RealReady;
	RightReload:
		ADPS YXW 2;
		ADPS N 0 A_StartSound("weapons/deagle/deploy", CHAN_AUTO);
		Goto Ready2+1;
	LeftReload:
		TNT1 A 0 A_BBLefthand(OverlayId());
		ADPS A 2;
		ADPS YXW 2;
		ADPS N 0 A_StartSound("weapons/deagle/deploy", CHAN_AUTO);
		Goto LeftSelect+2;
	LeftSelect:
		TNT1 A 0 A_BBLefthand(OverlayId());
		ADPS M 2 
		{
			A_StartSound("weapons/adpistol/deploy", CHAN_AUTO);
			A_StartSound("weapons/deagle/deploy", CHAN_AUTO);
		}
		ADPS NOPQRST 2;
		Goto GunReady;
 	Spawn:
		ADPS A -1;
		Stop;
	}
}

class DeathsheadMAC10 : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	action void MAC10PewPew() 
	{
		A_FireBullets (12, 5, 2, random(3,5), "BlueBastardBulletPuff", FBF_NORANDOM);
		A_FireBullets (12, 5, -1, random(3,5), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
		A_StartSound("weapons/mac10", CHAN_AUTO);
		A_WeaponOffset(random(-4.0,8.0), random(32.0,48.0),WOF_INTERPOLATE);
		A_SetPitch(self.pitch - 1, SPF_INTERPOLATE);
	}
	Default
	{
		Weapon.SelectionOrder 300;
		Weapon.AmmoType "BBDeathshead9mm";
		Weapon.AmmoGive 20;
		Weapon.AmmoUse 1;
		
		Weapon.BobSpeed 1.5;
		
		Tag "$ACE_MAC10";
		Obituary "$OB_ACE_MAC10";
		+INVENTORY.UNDROPPABLE
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADMC A 0 { player.mo.speed = 1.0; }
		ADMC D 1;
		ADMC E 2;
		ADMC F 1;
		ADMC G 2;
		ADMC H 1;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADMC H 1 A_StartSound("weapons/generic/draw");
		ADMC I 2;
		ADMC J 1;
		ADMC K 2;
		ADMC L 1;
		ADMC M 2 A_StartSound("weapons/mac10/deploy");
		ADMC N 1;
		ADMC O 2;
		ADMC P 1;
		ADMC Q 2;
		ADMC R 1;
		ADMC S 2;
	RealReady:
		ADMC A 0 { player.mo.speed = 1.08; }
		ADMC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADMC A 0 A_GunFlash;
		ADMC B 1 Bright MAC10PewPew();
		ADMC B 1 Bright A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		ADMC C 1 Bright MAC10PewPew();
		ADMC C 1 Bright A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		ADMC A 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADMC T 1 Bright A_Light2;
		ADMC U 1 Bright A_Light1;
		ADMC V 1 Bright A_Light2;
		ADMC W 1 Bright A_Light1;
		Goto LightDone;
	Spawn:
		ADMC A -1;
		Stop;
	}
}

class DeathsheadSG550 : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	bool zoom;
	Default
	{
		Weapon.SelectionOrder 600;
		Weapon.AmmoType1 "BBDeathshead556";
		Weapon.AmmoGive1 20;
		Weapon.AmmoUse1 2;
		Weapon.AmmoType2 "BBDeathshead556";
		Weapon.AmmoGive2 0;
		Weapon.AmmoUse2 0;
		
		Weapon.BobRangeX 1.25;
		
		+WEAPON.NOALERT
		+INVENTORY.UNDROPPABLE
		Tag "$ACE_SG550";
		Obituary "$OB_ACE_SG550";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPS F 2 {
			Invoker.zoom = false;
			A_ZoomFactor(1.0);
		}
		ADAS G 1;
		ADAS H 2;
		ADAS I 1;
		ADAS J 2;
		ADAS K 1;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADAS K 1 A_StartSound("weapons/sg550/deploy");
		ADAS J 1;
		ADAS I 2;
		ADAS H 1;
		ADAS G 2;
		ADAS F 1;
	RealReady:
		ADAS A 1 A_WeaponReady;
		Wait;
	RealReadyZoomed:
		TNT1 A 1 A_WeaponReady;
		Wait;
	Fire:
		ADPS A 0 {
			if (Invoker.zoom) { return ResolveState("FireZoomed"); }
			return ResolveState(null);
		}
		ADAS B 2 Bright
		{
			A_AlertMonsters();
			A_FireBullets (2, 3.5, -1, random(55,60), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/sg550", CHAN_AUTO);
			A_GunFlash();
			A_WeaponOffset(random(4.0,16.0), random(48.0,56.0),WOF_INTERPOLATE);
			A_SetPitch(self.pitch - 4, SPF_INTERPOLATE);
		}
		ADAS CC 1 Bright A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		ADAS DD 1 A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
		ADAS E 2 A_WeaponOffset(0.0, 32.0,WOF_INTERPOLATE);
		ADAS A 1;
		ADAS A 1 A_ReFire;
		Goto RealReady;
	FireZoomed:
		TNT1 A 0 Bright
		{
			A_AlertMonsters();
			A_FireBullets (0.5, 1, -1, random(65,70), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/sg550", CHAN_AUTO);
			A_SetPitch(self.pitch - 6, SPF_INTERPOLATE);
		}
		TNT1 AAA 2 Bright A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
		TNT1 AAA 1;
		TNT1 A 1 A_ReFire;
		Goto RealReadyZoomed;
	AltFire:
		ADAS N 0
		{
			A_StartSound("weapons/zoom", CHAN_AUTO);
			if (Invoker.zoom) { return ResolveState("UnZoom"); }
			return ResolveState(null);
		}
		ADAS N 1;
		ADAS O 2;
		ADAS P 1;
		ADAS Q 2 A_ZoomFactor(1.25);
		ADAS R 1 A_ZoomFactor(1.5);
		ADAS S 2 A_ZoomFactor(1.75);
		ADAS S 0 { Invoker.zoom = true; A_ZoomFactor(2.0); }
		Goto AltHold;
	UnZoom:
		ADAS S 1 A_ZoomFactor(1.75);
		ADAS R 2 A_ZoomFactor(1.5);
		ADAS Q 1 A_ZoomFactor(1.25);
		ADAS P 2 A_ZoomFactor(1.0);
		ADAS O 1;
		ADAS N 2;
		ADAS A 1 { Invoker.zoom = false; }
		Goto AltHold;
	AltHold:
		TNT1 A 0 A_JumpIf(Invoker.zoom,3);
		ADAS A 1;
		TNT1 A 0 A_ReFire("AltHold");
		Goto RealReady;
		TNT1 A 1;
		TNT1 A 0 A_ReFire("AltHold");
		Goto RealReadyZoomed;
	Flash:
		ADAS L 2 Bright A_Light2;
		ADAS M 2 Bright A_Light1;
		Goto LightDone;
	}
}

class DeathsheadM40A1 : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	bool zoom;
	Default
	{
		Weapon.SelectionOrder 600;
		Weapon.AmmoType1 "BBDeathshead762";
		Weapon.AmmoGive1 5;
		Weapon.AmmoUse1 1;
		Weapon.AmmoType2 "BBDeathshead762";
		Weapon.AmmoGive2 0;
		Weapon.AmmoUse2 0;
		
		Weapon.BobRangeX 1.25;
		
		+WEAPON.NOALERT
		+INVENTORY.UNDROPPABLE
		Tag "$ACE_M40A1";
		Obituary "$OB_ACE_M40A1";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADSS G 1 {
			Invoker.zoom = false;
			A_ZoomFactor(1.0);
		}
		ADSS F 1;
		ADSS E 2;
		ADSS D 1;
		ADSS C 2;
		ADSS B 1;
		ADSS A 2;
		ADSS A 1 A_Lower(24);
		Wait;
	Ready:
		ADSS A 1 A_StartSound("weapons/sniper/deploy");
		ADSS B 1;
		ADSS C 2;
		ADSS D 1;
		ADSS E 2;
		ADSS F 1;
		ADSS G 2;
		Goto RealReady;
	RealReady:
		ADSN A 1 A_WeaponReady;
		Wait;
	RealReadyZoomed:
		TNT1 A 1 A_WeaponReady;
		Wait;
	Fire:
		ADSN A 0 {
			if (Invoker.zoom) { return ResolveState("FireZoomed"); }
			return ResolveState(null);
		}
		ADSN B 2 Bright
		{
			A_AlertMonsters();
			A_FireBullets (2, 3.5, -1, random(125,140), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/sniper", CHAN_AUTO);
			A_GunFlash();
			A_SetPitch(self.pitch - 12, SPF_INTERPOLATE);
		}
		ADSN CC 1 Bright A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
		ADSR ABCD 1 A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
		ADSR EFG 1;
		ADSN H 1;
		ADSN I 1 A_StartSound("weapons/sniper/bolt", CHAN_AUTO);
		ADSN IJKLLMNOPQRRSTTUVW 1;
		ADSN A 1 A_ReFire;
		Goto RealReady;
	FireZoomed:
		TNT1 A 0 Bright
		{
			A_AlertMonsters();
			A_FireBullets (0.5, 1, -1, random(180,200), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/sniper", CHAN_AUTO);
			A_SetPitch(self.pitch - 12, SPF_INTERPOLATE);
		}
		TNT1 AAA 2 Bright A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
		ADSN E 1 { A_ZoomFactor(1.75); A_SetPitch(self.pitch + 2, SPF_INTERPOLATE); }
		ADSN F 2 { A_ZoomFactor(1.5); A_SetPitch(self.pitch + 2, SPF_INTERPOLATE); }
		ADSN G 1 { A_ZoomFactor(1.25); A_SetPitch(self.pitch + 2, SPF_INTERPOLATE); }
		ADSN H 2 A_ZoomFactor(1.0);
		ADSN I 1 A_StartSound("weapons/sniper/bolt", CHAN_AUTO);
		ADSN IJKLLMNOPQRRSTTUVW 1;
		ADSZ D 1 A_ZoomFactor(1.25);
		ADSZ E 1 A_ZoomFactor(1.5);
		ADSZ F 1 A_ZoomFactor(1.75);
		ADSZ F 1 A_ZoomFactor(2.0);
		ADSN F 0 A_ReFire;
		Goto RealReadyZoomed;
	AltFire:
		ADSZ A 0
		{
			A_StartSound("weapons/zoom", CHAN_AUTO);
			if (Invoker.zoom) { return ResolveState("UnZoom"); }
			return ResolveState(null);
		}
		ADSZ A 1;
		ADSZ B 2;
		ADSZ C 1;
		ADSZ D 2 A_ZoomFactor(1.25);
		ADSZ E 1 A_ZoomFactor(1.5);
		ADSZ F 1 A_ZoomFactor(1.75);
		ADSZ F 0 { Invoker.zoom = true; A_ZoomFactor(2.0); }
		Goto AltHold;
	UnZoom:
		ADSZ F 1 A_ZoomFactor(1.75);
		ADSZ E 2 A_ZoomFactor(1.5);
		ADSZ D 1 A_ZoomFactor(1.25);
		ADSZ C 2 A_ZoomFactor(1.0);
		ADSZ B 1;
		ADSZ A 1 { Invoker.zoom = false; }
		Goto AltHold;
	AltHold:
		TNT1 A 0 A_JumpIf(Invoker.zoom,3);
		ADSN A 1;
		TNT1 A 0 A_ReFire("AltHold");
		Goto RealReady;
		TNT1 A 1;
		TNT1 A 0 A_ReFire("AltHold");
		Goto RealReadyZoomed;
	Flash:
		ADSN X 2 Bright A_Light2;
		ADSN Y 2 Bright A_Light1;
		Goto LightDone;
	}
}

class DeathsheadM4 : BlueBastardWeapon
{
	mixin BBDeathsheadWeapon;
	Default
	{
		Weapon.SelectionOrder 100;
		Weapon.AmmoType1 "BBDeathshead556";
		Weapon.AmmoType2 "BBDeathsheadGrenade";
		Weapon.AmmoUse1 1;
		Weapon.AmmoUse2 1;
		Weapon.AmmoGive1 20;
		Weapon.AmmoGive2 2;
		
		Tag "$ACE_M4";
		Obituary "$OB_ACE_M4";
		+INVENTORY.UNDROPPABLE
		+WEAPON.ALT_AMMO_OPTIONAL
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADM4 F 1;
		ADM4 G 2;
		ADM4 H 1;
		ADM4 I 2;
		ADM4 J 1;
		ADM4 K 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADM4 K 1 A_StartSound("weapons/autoshotgun/deploy");
		ADM4 J 2;
		ADM4 I 1;
		ADM4 H 2;
		ADM4 G 1;
		ADM4 F 2;
		ADM4 E 1;
	RealReady:
		ADM4 A 1 A_WeaponReady;
		Loop;
	Fire:
		ADM4 B 1 Bright
		{
			A_FireBullets (4.5, 3, -1, random(6,10), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_FireBullets (4.5, 3, -1, random(6,10), "BlueBastardBulletPuff", FBF_NORANDOM);
			A_StartSound("weapons/m4", CHAN_AUTO);
			A_WeaponOffset(random(-4.0,8.0), random(32.0,48.0),WOF_INTERPOLATE);
			A_GunFlash();
			A_SetPitch(self.pitch - 1.5, SPF_INTERPOLATE);
		}
		ADM4 C 0 Bright A_WeaponOffset(0.0, 32.0,WOF_INTERPOLATE);
		ADM4 CC 1 Bright A_SetPitch(self.pitch + 0.75, SPF_INTERPOLATE);
		ADM4 DE 2 A_ReFire;
		Goto RealReady;
	DryFire:
		ADM4 B 2
		{
			A_WeaponOffset(random(-2.0,4.0), random(32.0,36.0),WOF_INTERPOLATE);
			A_StartSound("weapons/dryfire", CHAN_AUTO);
		}
		ADM4 C 2 A_WeaponOffset(0.0, 32.0,WOF_INTERPOLATE);
		ADM4 DE 2;
		Goto RealReady;
	AltFire:
		TNT1 A 0 A_JumpIfInventory("BBDeathsheadGrenade",1,1);
		Goto DryFire;
		ADM4 B 2 
		{
			A_FireProjectile("DeathsheadM4Grenade",0,true,0,0,0,-6);
			A_StartSound("weapons/m4/grenade", CHAN_AUTO);
			A_SetPitch(self.pitch - 1, SPF_INTERPOLATE);
		}
		ADM4 CC 1 A_SetPitch(self.pitch + 0.5, SPF_INTERPOLATE);
		ADM4 DEA 2;
		ADM4 A 14 A_WeaponReady(WRF_NOSECONDARY);
		Goto RealReady;
	Flash:
		ADM4 L 1 Bright A_Light1;
		ADM4 M 2 Bright A_Light2;
		Goto LightDone;
	Spawn:
		ADMC A -1;
		Stop;
	}
}

class DeathsheadM4Grenade : Grenade
{
	Default
	{
		BounceType "None";
		SeeSound "";
		DeathSound "weapons/rocklx";
		Obituary "$OB_ACE_M4_GRENADE";
	}
	States
	{
	Spawn:
		M4GR A 1;
		Loop;
	}
}

