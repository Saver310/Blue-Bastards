#include "./spot/ammo.zsc"
#include "./spot/intros.zsc"
#include "./spot/melee.zsc"
#include "./spot/bullet.zsc"
#include "./spot/shells.zsc"
#include "./spot/rockets.zsc"
#include "./spot/cells.zsc"
#include "./spot/dragon.zsc"

mixin class BBSpotWeapon //the mixing classes are classes you add in to the class, which is great for more minor stuff.
{
	default //Side note, DO NOT put this mixin in anything that is not weapon related or it will cause errors.
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		Inventory.RestrictedTo "Spot"; //If you want to make sure the custom inventory is only for a certain character, just copy paste this.
	}
}
