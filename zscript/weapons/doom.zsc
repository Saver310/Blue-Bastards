class ShotgunReplacement : BB_RescaleWeaponsBecauseImLazy replaces Shotgun
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT3";
		Tag "$TAG_SHOTGUN";
		inventory.pickupsound "";
	}
	States
	{
	Spawn:
		WPN3 A 8;
		WPN3 A 8 Bright;
		WPN3 AABC 2;
		WPN3 DEFG 2 Bright;
		WPN3 HIJA 2;
		WPN3 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (frandom(0,1) < bb_sg_ssgs_chance)
			{
				a_giveinventory("SuperShotgunReplacement",1,false);
				return;
			}
			if(Checkinventory("SpotShotgun",1) || Checkinventory("deathsheadshotgun",1))
			{
				a_giveinventory("Shell",4,false);
				A_startsound("misc/metalslug");
				return;
			}
			if (CheckInventory("SpotMallet", 1)) 
			{
				A_GiveInventory("SpotShotgun", 1, false);
				A_startsound("misc/metalslug/shotgun");
			}
		
			if (CheckInventory("DeathsheadFist", 1))
			{ 
				A_GiveInventory("DeathsheadShotgun", 1, false);
				A_startsound("misc/metalslug/shotgun");
			}
		}
		Stop;
	}
}

class SuperShotgunReplacement : BB_RescaleWeaponsBecauseImLazy replaces SuperShotgun
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT3PLUS";
		Inventory.PickupSound " ";
		Tag "$TAG_SUPERSHOTGUN";
	}
	States
	{
	Spawn:
		WPNS A 8;
		WPNS A 8 Bright;
		WPNS AABC 2;
		WPNS DEFG 2 Bright;
		WPNS HIJA 2;
		WPNS A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1))
				{
					if(CheckInventory("SpotDevastator", 1) && CheckInventory("SpotShotgunClassic",1))
					{
						a_giveinventory("Shell",4,false);
						a_giveinventory("BBSpotDevastatorShell",4,false);
						A_startsound("misc/metalslug");
						return;
					}
					if(CheckInventory("SpotDevastator", 1) && !CheckInventory("SpotShotgunClassic",1))
					{
						A_GiveInventory("SpotShotgunClassic", 1, false);
						A_startsound("misc/metalslug/supershotgun");
						return;
					}
					if(CheckInventory("SpotShotgunClassic", 1) && !CheckInventory("SpotDevastator",1))
					{
						A_GiveInventory("SpotDevastator", 1, false);
						A_GiveInventory("BBSpotDevastatorShell", 4, false);
						A_startsound("misc/metalslug/supershotgun");
						return;
					}
					switch (random(0,1)) 
					{
					case 0:
					  A_GiveInventory("SpotDevastator", 1, false);
					  A_GiveInventory("BBSpotDevastatorShell", 4, false);
					  break;
					case 1:
					  A_GiveInventory("SpotShotgunClassic", 1, false);
					  break;
					}
					A_startsound("misc/metalslug/supershotgun");
				}
				if (CheckInventory("DeathsheadSuperShotgun", 1))
				{
					a_giveinventory("Shell",8,false);
					A_startsound("misc/metalslug");
					return;
				}
				if (CheckInventory("DeathsheadFist", 1)) 
				{
					A_GiveInventory("DeathsheadSuperShotgun", 1, false);
					A_startsound("misc/metalslug/supershotgun");
					return;
		}		}
		Stop;
	}
}

class ChaingunReplacement : BB_RescaleWeaponsBecauseImLazy replaces Chaingun
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT4";
		Inventory.PickupSound "misc/hmg_pkup";
		Tag "$TAG_CHAINGUN";
	}
	States
	{
	Spawn:
		WPN4 A 8;
		WPN4 A 8 Bright;
		WPN4 AABC 2;
		WPN4 DEFG 2 Bright;
		WPN4 HIJA 2;
		WPN4 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1))
			{
				
				if(CheckInventory("SpotChaingun", 1) && CheckInventory("SpotM249",1))
				{
					a_giveinventory("BBSpotNavalBullets",20,false);
					a_giveinventory("Clip",20,false);
					A_startsound("misc/metalslug");
					return;
				}
				if(CheckInventory("SpotChaingun", 1) && !CheckInventory("SpotM249",1))
				{
					A_GiveInventory("SpotM249", 1, false);
					A_startsound("misc/metalslug/hmg");
					return;
				}
				if(CheckInventory("SpotM249", 1) && !CheckInventory("SpotChaingun",1))
				{
					A_GiveInventory("SpotChaingun", 1, false);
					A_startsound("misc/metalslug/hmg");
					return;
				}
				switch (random(0,1)) {
				case 0:
				  A_GiveInventory("SpotChaingun", 1, false);
				  break;
				case 1:
				  A_GiveInventory("SpotM249", 1, false);
				  break;
				}
			}
			if (CheckInventory("DeathsheadFist", 1)) //THIS SORTING SYSTEM IS QUITE LITERALLY BOILER PLATED AS FUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUCK -redead
			{
				
				if(CheckInventory("DeathsheadMAC10", 1) && CheckInventory("DeathsheadM4",1) && CheckInventory("DeathsheadM40A1",1))
				{
					a_giveinventory("BBDeathshead9mm",20,false);
					a_giveinventory("BBDeathshead556",20,false);
					a_giveinventory("BBDeathshead762",2,false);
					A_startsound("misc/metalslug");
					return;
				}
				if(CheckInventory("DeathsheadMAC10", 1) && !CheckInventory("DeathsheadM4",1) && !CheckInventory("DeathsheadM40A1",1))
				{
					switch (random(0,1)) {
					case 0:
					  A_GiveInventory("DeathsheadM4", 1, false);
					  break;
					case 1:
					  A_GiveInventory("DeathsheadM40A1", 1, false);
					  break;
					}
					A_startsound("misc/metalslug/hmg");
					return;
				}
				if(!CheckInventory("DeathsheadMAC10", 1) && CheckInventory("DeathsheadM4",1) && !CheckInventory("DeathsheadM40A1",1))
				{
					switch (random(0,1)) {
					case 0:
					  A_GiveInventory("DeathsheadMAC10", 1, false);
					  break;
					case 1:
					  A_GiveInventory("DeathsheadM40A1", 1, false);
					  break;
					}
					A_startsound("misc/metalslug/hmg");
					return;
				}
				if(!CheckInventory("DeathsheadMAC10", 1) && !CheckInventory("DeathsheadM4",1) && CheckInventory("DeathsheadM40A1",1))
				{
					switch (random(0,1)) {
					case 0:
					  A_GiveInventory("DeathsheadM4", 1, false);
					  break;
					case 1:
					  A_GiveInventory("DeathsheadMAC10", 1, false);
					  break;
					}
					A_startsound("misc/metalslug/hmg");
					return;
				}
				if(!CheckInventory("DeathsheadMAC10", 1) && CheckInventory("DeathsheadM4",1) && CheckInventory("DeathsheadM40A1",1))
				{ 
					A_GiveInventory("DeathsheadMAC10", 1, false);
					A_startsound("misc/metalslug/hmg");
					return;
				}
				if(CheckInventory("DeathsheadMAC10", 1) && !CheckInventory("DeathsheadM4",1) && CheckInventory("DeathsheadM40A1",1))
				{ 
					A_GiveInventory("DeathsheadM4", 1, false);
					A_startsound("misc/metalslug/hmg");
					return;
				}
				if(CheckInventory("DeathsheadMAC10", 1) && CheckInventory("DeathsheadM4",1) && !CheckInventory("DeathsheadM40A1",1))
				{ 
					A_GiveInventory("DeathsheadM40A1", 1, false);
					A_startsound("misc/metalslug/hmg");
					return;
				}
				switch (random(0,2)) {
				case 0:
				  A_GiveInventory("DeathsheadMAC10", 1, false);
				  break;
				case 1:
				  A_GiveInventory("DeathsheadM4", 1, false);
				  break;
				case 2:
				  A_GiveInventory("DeathsheadM40A1", 1, false);
				  break;
				}
				A_startsound("misc/metalslug/hmg");
			}
		}
		Stop;
	}
}

class RocketLauncherReplacement : BB_RescaleWeaponsBecauseImLazy replaces RocketLauncher
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT5";
		Inventory.PickupSound "misc/rl_pkup";
		Tag "$TAG_ROCKETLAUNCHER";
	}
	States
	{
	Spawn:
		WPN5 A 8;
		WPN5 A 8 Bright;
		WPN5 AABC 2;
		WPN5 DEFG 2 Bright;
		WPN5 HIJA 2;
		WPN5 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1))
			{ 
				if(CheckInventory("SpotRocketLauncher", 1))
				{
					A_Giveinventory("Rocketammo",4);
					A_startsound("misc/metalslug");
					return;
				}
				else 
				{
					A_GiveInventory("SpotRocketLauncher", 1, false);
					A_startsound("misc/metalslug/rl");
					return;
				}
			
			}
			if (CheckInventory("DeathsheadFist", 1))
			{ 
				if(CheckInventory("DeathsheadRocketLauncher", 1))
				{
					A_Giveinventory("Rocketammo",2);
					A_startsound("misc/metalslug");
					return;
				}
				else 
				{
					A_GiveInventory("DeathsheadRocketLauncher", 1, false);
					A_startsound("misc/metalslug/rl");
					return;
				}
			}
		
		}
		Stop;
	}
}

class PlasmaRifleReplacement : BB_RescaleWeaponsBecauseImLazy replaces PlasmaRifle
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT6";
		Inventory.PickupSound "misc/laser_pkup";
		Tag "$TAG_PLASMARIFLE";
	}
	States
	{
	Spawn:
		WPN6 A 8;
		WPN6 A 8 Bright;
		WPN6 AABC 2;
		WPN6 DEFG 2 Bright;
		WPN6 HIJA 2;
		WPN6 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1)) 
			{ 
				if(CheckInventory("SpotPlasmaRifle", 1))
				{
					A_Giveinventory("Cell",40);
					A_startsound("misc/metalslug");
					return;
				}
				else 
				{
					A_GiveInventory("SpotPlasmaRifle", 1, false);
					A_startsound("misc/metalslug/laser");
					return;
				}
			
			}
			if (CheckInventory("DeathsheadFist", 1))
			{ 
				if(CheckInventory("DeathsheadPlasmaRifle", 1))
				{
					A_Giveinventory("Cell",40);
					A_startsound("misc/metalslug");
					return;
				}
				else 
				{
					A_GiveInventory("DeathsheadPlasmaRifle", 1, false);
					A_startsound("misc/metalslug/laser");
					return;
				}
			
			}
		}
		Stop;
  }
}

class BFG9000Replacement : BB_RescaleWeaponsBecauseImLazy replaces BFG9000
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT7";
		Inventory.PickupSound "misc/bfg_pkup";
		Tag "$TAG_BFG9000";
	}
	States
	{
	Spawn:
		WPN7 A 8;
		WPN7 A 8 Bright;
		WPN7 AABC 2;
		WPN7 DEFG 2 Bright;
		WPN7 HIJA 2;
		WPN7 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1))
			{ 
				if(CheckInventory("SpotBFG", 1))
				{
					A_Giveinventory("BBSpotAtomicBomb",1);
					A_startsound("misc/metalslug");
					return;
				}
				else 
				{
					A_GiveInventory("SpotBFG", 1, false);
					A_startsound("misc/metalslug/bfg");
					return;
				}
			
			}
			if (CheckInventory("DeathsheadFist", 1))
			{ 
				if(CheckInventory("DeathsheadBFG", 1))
				{
					A_Giveinventory("BBDeathsheadBFGCell",1);
					A_startsound("misc/metalslug");
					return;
				}
				else 
				{
					A_GiveInventory("DeathsheadBFG", 1, false);
					A_startsound("misc/metalslug/bfg");
					return;
				}
			
			}
		}
		Stop;
  }
}
