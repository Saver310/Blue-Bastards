				if(A_AllowedToGrab("BBDeathsheadGrenade") || A_AllowedToGrab("RocketAmmo")) 
				{ 
					A_GiveInventory("BBDeathsheadGrenade", A_ammomultiplier(2), false);
					A_GiveInventory("RocketAmmo", 1, false);
					return resolvestate(null);
