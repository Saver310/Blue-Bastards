class BlueBastardBackpack : Backpack replaces Backpack
{
	Default
	{
		Inventory.PickupMessage "$GOTBACKPACK";
		Inventory.PickupSound "misc/metalslug";
	}
	States
	{
	Spawn:
		BPAK A 16;
		BPAK BCDEF 2;
		Loop;
	}
}

class SoulsphereReplacement : Soulsphere replaces Soulsphere
{
	override bool TryPickup (in out Actor other)
	{
		PrevHealth = other.player != NULL ? other.player.health : other.health;
		
		int blehhh = 200;
		if (other.FindInventory("SpotMallet"))
		{
			blehhh += 50;
		}
		if (other.GiveBody(Amount, blehhh))
		{
			GoAwayAndDie();
			return true;
		}
		return false;
	}
}


class BBClip : BBAmmoDistributor replaces clip
{
	Default
	{
		Inventory.PickupMessage "$GOTCLIP";
		/*Inventory.Amount 10;
		Inventory.MaxAmount 200;
		Ammo.BackpackAmount 10;
		Ammo.BackpackMaxAmount 400;
		Inventory.Icon "CLIPA0";*/
		Tag "$AMMO_CLIP";
	}
	States
	{
	Spawn:
		CLIP A -1;
		Stop;
	Pickup:
		TNT1 A 0
		{

			if (CheckInventory("SpotMallet", 1)) 
			{
	
				if(A_AllowedToGrab("BBSpot600") || A_AllowedToGrab("BBSpotNavalBullets") || A_AllowedToGrab("Clip"))
				{
					
					A_GiveInventory("BBSpot600", A_ammomultiplier(2), false);
					A_GiveInventory("BBSpotNavalBullets", A_ammomultiplier(10), false);
					A_GiveInventory("Clip", A_ammomultiplier(10), false);
					return resolvestate(null);
				}else return resolvestate("cantpickup");
			}
			if (CheckInventory("DeathsheadFist", 1))
			{ 
				if(A_AllowedToGrab("BBDeathshead9mm") || A_AllowedToGrab("BBDeathshead556"))
				{
					A_GiveInventory("BBDeathshead9mm", A_ammomultiplier(10), false);
					A_GiveInventory("BBDeathshead556", A_ammomultiplier(10), false);
					return resolvestate(Null);
				} else return resolvestate("cantpickup");
			}
			return resolvestate(null);
		}
		TNT1 A 1 A_Railwait(); //This function does nothing, but the entire anonymous function system would always fail if there was no function afterwards...
		stop;	
		
	}
}
	

