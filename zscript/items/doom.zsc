class BBRocketAmmo : BBAmmoDistributor replaces RocketAmmo
{
	Default
	{
		Inventory.PickupMessage "$GOTROCKET";
		Tag "$AMMO_ROCKETS";
	}
	States
	{
	Spawn:
		ROCK A -1;
		Stop;
	Pickup:
		TNT1 A 0
		{
			
			if (CheckInventory("SpotMallet", 1)) 
			{
				if(A_AllowedToGrab("RocketAmmo")) 
				{ 
					A_GiveInventory("RocketAmmo", 1, false);
					return resolvestate(null);
				}else return resolvestate("cantpickup");
			}
			
			if (CheckInventory("DeathsheadFist", 1))
