#include "zscript/items/hexen.zsc"
#include "zscript/items/strife.zsc"

class BlueBastardHealthBonus : HealthBonus
{
	override bool TryPickup (in out Actor other)
	{
		PrevHealth = other.player != NULL ? other.player.health : other.health;
		
		int blehhh = 200;
		if (other.FindInventory("SpotMallet"))
		{
			blehhh += 50;
		}
		if (other.GiveBody(Amount, blehhh))
		{
			GoAwayAndDie();
			return true;
		}
		return false;
	}
}

class BlueBastardsBerserk : CustomInventory Replaces Berserk {
	Default
	{
		+COUNTITEM
		+INVENTORY.ALWAYSPICKUP
		+INVENTORY.ISHEALTH
		Inventory.PickupMessage "$GOTBERSERK";
		Inventory.PickupSound "misc/berserk";
	}

	override bool TryPickup (in out Actor toucher)
	{
		let pickupstate = FindState('Pickup');
		bool useok = CallStateChain (toucher, pickupstate);

		if ((useok || pickupstate == NULL) && FindState('Use') != NULL)
		{
			useok = Super.TryPickup (toucher);
		}

		if (useok) {
			if (allow_spot_dragon) {
				if (toucher.FindInventory("SpotMallet"))
				{
					toucher.A_GiveInventory("Dragon_Spot_Transform");
					let [k1, k2] = Bindings.GetKeysForCommand("+reload");
					string s1 = Bindings.NameKeys(k1, k2);
					string tip = String.Format(StringTable.Localize("$SPOT_TRANSFORM_TIP"), s1);
					toucher.A_Print(tip);
				}
				if (toucher.FindInventory("DeathsheadFist"))
				{
					toucher.A_GiveInventory("Mothman_Transform");
					let [k1, k2] = Bindings.GetKeysForCommand("+reload");
					string s1 = Bindings.NameKeys(k1, k2);
					string tip = String.Format(StringTable.Localize("$ACE_TRANSFORM_TIP"), s1);
					toucher.A_Print(tip);
				}
			}
			GoAwayAndDie();
		}
		return useok;
	}

	States
	{
	Spawn:
		PSTR A -1 Bright;
		Stop;
	Pickup:
		TNT1 A 0 A_GiveInventory("PowerStrength");
		TNT1 A 0 HealThing(100, 0);
		TNT1 A 0 A_SelectWeapon("SpotMallet");
		TNT1 A 0 A_SelectWeapon("DeathsheadFist");
		Stop;
	}
}

class BlueBastardsTransformationFog : Actor
{
	default
	{
		+NOBLOCKMAP
		+NOTELEPORT
		+NOGRAVITY
		+ZDOOMTRANS
		RenderStyle "Add";
	}
	States
	{
	Spawn:
		TFOG ABABCDEFGHIJ 2 Bright;
		Stop;
	}
	override void PostBeginPlay ()
	{
		Super.PostBeginPlay ();
		A_StartSound ("misc/transformation", CHAN_BODY);
	}
}

